---
/**
 * Wraps ALL editorial (non-WHO) content — guardrail §3.3, the single most
 * important compliance UI pattern. Renders the verbatim §11 label, plus the
 * draft badge while status is "draft". Machine-readable via data-source.
 *
 * Foundations restyle: a flat block opened by a hairline, with the labels as
 * mono caption text in the project's `editorial` status colour (text-safe on
 * both grounds, never a fill or border — kit README, status colours).
 */
interface Props {
  status: "draft" | "clinician-reviewed";
}

const { status } = Astro.props;
---

<div
  data-source="editorial"
  data-status={status}
  class="border-t border-hairline pt-4"
>
  <p class="caption mb-5 flex flex-wrap gap-x-5 gap-y-1 uppercase">
    <span class="text-editorial">Redaksjonelt innhold – ikke fra WHO</span>
    {
      status === "draft" && (
        <span class="text-ink-muted">Utkast – ikke klinisk kvalitetssikret</span>
      )
    }
  </p>
  <slot />
</div>
