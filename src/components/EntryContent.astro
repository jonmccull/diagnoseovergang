---
/**
 * Renders one CommentaryEntry (§8). Layout per §12: side-by-side
 * ICD-10 (før) vs ICD-11 (nå) where codes exist, then the editorial sections.
 * Everything except the official WHO cards sits inside EditorialBlock (§3.3).
 */
import type { CollectionEntry } from "astro:content";
import EditorialBlock from "./EditorialBlock.astro";
import IcdEntityCard from "./IcdEntityCard.astro";
import { FEEDBACK_HINT } from "../config";

interface Props {
  entry: CollectionEntry<"pd">;
  headingLevel?: "h1" | "h2";
}

const { entry, headingLevel = "h1" } = Astro.props;
const d = entry.data;
const Heading = headingLevel;
const Sub = headingLevel === "h1" ? "h2" : "h3";
const hasCodes = (d.icd10?.length ?? 0) > 0 || (d.icd11?.length ?? 0) > 0;
---

<article data-entry-id={d.id}>
  <EditorialBlock status={d.status}>
    <Heading
      data-field="title_nb"
      class="heading text-ink"
    >
      {d.title_nb}
    </Heading>

    {
      hasCodes && (
        <section
          aria-label="Kodesammenligning ICD-10 og ICD-11"
          class="mt-5 grid gap-4 md:grid-cols-2"
        >
          <div>
            <p class="caption mb-2 uppercase text-ink-muted">Før – ICD-10</p>
            {d.icd10?.length ? (
              <ul>
                {d.icd10.map((ref) => (
                  <li class="border-t border-hairline py-3">
                    <span class="font-mono font-medium text-ink">{ref.code}</span>
                    <span aria-hidden="true"> · </span>
                    <span>{ref.label_nb}</span>
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-ink-muted">Ingen direkte ICD-10-motpart.</p>
            )}
          </div>
          <div>
            <p class="caption mb-2 uppercase text-ink-muted">Nå – ICD-11</p>
            {d.icd11?.length ? (
              <ul>
                {d.icd11.map((ref) => (
                  <li>
                    <IcdEntityCard code={ref.code} />
                  </li>
                ))}
              </ul>
            ) : (
              <p class="text-sm text-ink-muted">Se løpende tekst.</p>
            )}
          </div>
        </section>
      )
    }

    <section class="mt-6 max-w-prose" data-field="whatChanged_nb">
      <Sub class="title text-ink">Hva endres?</Sub>
      <p class="mt-2 text-ink-secondary">{d.whatChanged_nb}</p>
    </section>

    <section class="mt-5 max-w-prose" data-field="whatToDoNow_nb">
      <Sub class="title text-ink">Hva gjør du nå?</Sub>
      <p class="mt-2 text-ink-secondary">{d.whatToDoNow_nb}</p>
    </section>

    {
      d.caveats_nb && (
        <section class="mt-5 max-w-prose" data-field="caveats_nb">
          <Sub class="title text-ink">Verdt å merke seg</Sub>
          <p class="mt-2 text-ink-secondary">{d.caveats_nb}</p>
        </section>
      )
    }

    {
      d.sources?.length && (
        <section class="mt-5 max-w-prose">
          <Sub class="title text-ink">Kilder</Sub>
          <ul class="mt-2 list-disc pl-5 text-ink-secondary">
            {d.sources.map((s) => (
              <li>
                <a href={s.url} class="fdn-link">
                  {s.label}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </EditorialBlock>

  {/* Feedback affordance (§9.1/§12): highlight-to-comment hint + fallback button.
      The FeedbackWidget island (mounted globally) wires the click. */}
  <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-muted">
    <p>{FEEDBACK_HINT}</p>
    <button
      type="button"
      data-feedback-trigger
      data-entry-id={d.id}
      class="fdn-link"
    >
      Gi tilbakemelding
    </button>
  </div>
</article>
