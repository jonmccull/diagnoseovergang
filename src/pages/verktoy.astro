---
import Base from "../layouts/Base.astro";
import EditorialBlock from "../components/EditorialBlock.astro";
import { PdSeverityTraitTool } from "../components/PdSeverityTraitTool";
---

<Base
  title="Kodehjelp: alvorlighetsgrad og trekk"
  description="Pedagogisk hjelpemiddel for å sette sammen et ICD-11-kodemønster for personlighetsforstyrrelser: alvorlighetsgrad + trekkdomener."
>
  <nav aria-label="Brødsmulesti" class="mb-6 text-sm">
    <a href="/" class="fdn-link text-sm"
      >← Til forsiden</a
    >
  </nav>

  <h1 class="display-lg text-ink">
    Kodehjelp: alvorlighetsgrad og trekk
  </h1>
  <p class="lead mt-4 max-w-prose text-ink-secondary">
    Sett sammen et ICD-11-kodemønster steg for steg: velg alvorlighetsgrad,
    angi fremtredende trekkdomener, og legg eventuelt til borderline-mønster.
  </p>

  <section class="mt-8">
    <EditorialBlock status="draft">
      <PdSeverityTraitTool client:load />
    </EditorialBlock>
  </section>
</Base>
