---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntryContent from "../components/EntryContent.astro";
import EditorialBlock from "../components/EditorialBlock.astro";
import { CrosswalkExplorer } from "../components/CrosswalkExplorer";
import { buildCrosswalkItems } from "../lib/crosswalk";
import { SITE_TAGLINE } from "../config";

const entries = await getCollection("pd");
const crosswalkItems = buildCrosswalkItems(entries);
const genericCaveat =
  entries.find((e) => e.data.kind === "overview")?.data.caveats_nb ??
  "Overgangen er ikke én-til-én; flere trekkdomener kan være aktuelle samtidig.";
const overview = entries.find((e) => e.data.kind === "overview");
const byKind = (kind: string) =>
  entries
    .filter((e) => e.data.kind === kind)
    .sort((a, b) => a.data.title_nb.localeCompare(b.data.title_nb, "nb"));
const traits = entries
  .filter((e) => e.data.kind === "trait-domain")
  .sort((a, b) =>
    (a.data.icd11?.[0]?.code ?? "").localeCompare(b.data.icd11?.[0]?.code ?? "")
  );

// Ordered to mirror the clinical priority of the rollout (Amendment A.4).
const sections = [
  { heading: "Nye diagnoser i ICD-11", items: byKind("new-diagnosis") },
  { heading: "Diagnoser som er endret", items: byKind("diagnosis-change") },
  { heading: "Grupperinger som er endret", items: byKind("grouping-overview") },
  { heading: "Flyttet ut av kapittel 06", items: byKind("relocation") },
  { heading: "Alvorlighetsgrad", items: byKind("severity") },
  { heading: "Trekkdomener og mønstre (6D11)", items: traits },
].filter((s) => s.items.length > 0);
---

<Base
  title="Forside"
  description="Norsk ressurs som forklarer hva som endres fra ICD-10 til ICD-11 for psykiske lidelser (kapittel 06)."
>
  <h1 class="display-lg text-ink">
    {SITE_TAGLINE}
  </h1>
  <p class="lead mt-4 max-w-prose text-ink-secondary">
    En fri, norskspråklig ressurs som forklarer hva som endres i overgangen fra
    ICD-10 til ICD-11 for psykiske lidelser (kapittel 06) – med offisielle
    ICD-11-koder og titler hentet direkte fra WHO.
  </p>

  <section class="mt-10" aria-label="Krysskoblingsoppslag">
    <EditorialBlock status="draft">
      <h2 class="title text-ink">
        Fra ICD-10-kode til ICD-11
      </h2>
      <div class="mt-4">
        <CrosswalkExplorer
          client:load
          items={crosswalkItems}
          genericCaveat_nb={genericCaveat}
        />
      </div>
    </EditorialBlock>
  </section>

  <section class="mt-6 border-t border-b border-hairline">
    <a
      href="/verktoy"
      class="fdn-row-link flex items-center justify-between gap-4 py-4"
    >
      <span>
        <span class="fdn-row-title font-medium"
          >Kodehjelp: alvorlighetsgrad og trekk</span
        >
        <span class="mt-0.5 block text-sm text-ink-muted"
          >Sett sammen et ICD-11-kodemønster steg for steg. Pedagogisk
          hjelpemiddel.</span
        >
      </span>
      <span aria-hidden="true" class="text-ink-muted">→</span>
    </a>
  </section>

  {
    overview && (
      <div class="mt-10">
        <EntryContent entry={overview} headingLevel="h2" />
      </div>
    )
  }

  {
    sections.map(({ heading, items }) => (
      <section class="mt-10">
        <h2 class="heading text-ink">{heading}</h2>
        <ul class="mt-4 border-b border-hairline">
          {items.map((e) => (
            <li class="fdn-row">
              <a href={`/endringer/${e.id}`} class="fdn-row-link">
                <span>
                  <span class="fdn-row-title font-medium">{e.data.title_nb}</span>
                  {e.data.status === "draft" && (
                    <span class="caption ml-3 uppercase text-ink-muted">Utkast</span>
                  )}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
