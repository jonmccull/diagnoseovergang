---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import EntryContent from "../components/EntryContent.astro";
import EditorialBlock from "../components/EditorialBlock.astro";
import { CrosswalkExplorer } from "../components/CrosswalkExplorer";
import { buildCrosswalkItems } from "../lib/crosswalk";
import { SITE_TAGLINE } from "../config";

const entries = await getCollection("pd");
const crosswalkItems = buildCrosswalkItems(entries);
const genericCaveat =
  entries.find((e) => e.data.kind === "overview")?.data.caveats_nb ??
  "Overgangen er ikke én-til-én; flere trekkdomener kan være aktuelle samtidig.";
const overview = entries.find((e) => e.data.kind === "overview");
const diagnoses = entries.filter((e) => e.data.kind === "diagnosis-change");
const severity = entries.filter((e) => e.data.kind === "severity");
const traits = entries
  .filter((e) => e.data.kind === "trait-domain")
  .sort((a, b) =>
    (a.data.icd11?.[0]?.code ?? "").localeCompare(b.data.icd11?.[0]?.code ?? "")
  );

const sections = [
  { heading: "Alvorlighetsgrad", items: severity },
  { heading: "Diagnoser: fra ICD-10-kode til ICD-11", items: diagnoses },
  { heading: "Trekkdomener og mønstre (6D11)", items: traits },
];
---

<Base
  title="Forside"
  description="Norsk ressurs som forklarer hva som endres fra ICD-10 til ICD-11 for personlighetsforstyrrelser."
>
  <h1 class="text-3xl font-bold tracking-tight text-slate-900">
    {SITE_TAGLINE}
  </h1>
  <p class="mt-4 max-w-prose text-lg text-slate-700">
    En fri, norskspråklig ressurs som forklarer hva som endres i overgangen fra
    ICD-10 til ICD-11 for personlighetsforstyrrelser – med offisielle
    ICD-11-koder og titler hentet direkte fra WHO.
  </p>

  <section class="mt-10" aria-label="Krysskoblingsoppslag">
    <EditorialBlock status="draft">
      <h2 class="text-xl font-semibold text-slate-900">
        Fra ICD-10-kode til ICD-11
      </h2>
      <div class="mt-4">
        <CrosswalkExplorer
          client:load
          items={crosswalkItems}
          genericCaveat_nb={genericCaveat}
        />
      </div>
    </EditorialBlock>
  </section>

  <section class="mt-6">
    <a
      href="/verktoy"
      class="flex items-center justify-between gap-4 rounded-lg border border-slate-300 bg-white p-4 hover:border-slate-500"
    >
      <span>
        <span class="font-medium text-slate-900"
          >Kodehjelp: alvorlighetsgrad og trekk</span
        >
        <span class="mt-0.5 block text-sm text-slate-600"
          >Sett sammen et ICD-11-kodemønster steg for steg. Pedagogisk
          hjelpemiddel.</span
        >
      </span>
      <span aria-hidden="true" class="text-slate-400">→</span>
    </a>
  </section>

  {
    overview && (
      <div class="mt-10">
        <EntryContent entry={overview} headingLevel="h2" />
      </div>
    )
  }

  {
    sections.map(({ heading, items }) => (
      <section class="mt-10">
        <h2 class="text-xl font-semibold text-slate-900">{heading}</h2>
        <ul class="mt-3 space-y-2">
          {items.map((e) => (
            <li>
              <a
                href={`/endringer/${e.id}`}
                class="block rounded-lg border border-slate-200 bg-white p-4 hover:border-slate-400"
              >
                <span class="font-medium text-slate-900">{e.data.title_nb}</span>
                {e.data.status === "draft" && (
                  <span class="ml-2 inline-flex items-center rounded-full bg-slate-200 px-2 py-0.5 text-xs text-slate-700">
                    Utkast
                  </span>
                )}
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>
