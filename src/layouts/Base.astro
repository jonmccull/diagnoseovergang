---
import "../styles/global.css";
import {
  SITE_NAME,
  INDEPENDENCE_DISCLAIMER,
  WHO_ATTRIBUTION,
  WHO_SOURCE_URL,
} from "../config";
import { FeedbackWidget } from "../components/FeedbackWidget";

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · {SITE_NAME}</title>
    {description && <meta name="description" content={description} />}
    {/* Foundations kit: the one Google Fonts link (Outfit 300/400/500, JetBrains Mono 400/500). */}
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    {/* Kit dark theme: follow the OS by mapping prefers-color-scheme to
        data-theme on the root, before first paint so there is no flash.
        Light is the default and carries no attribute. */}
    <script is:inline>
      (function () {
        var mq = window.matchMedia("(prefers-color-scheme: dark)");
        function apply() {
          if (mq.matches) {
            document.documentElement.setAttribute("data-theme", "dark");
          } else {
            document.documentElement.removeAttribute("data-theme");
          }
        }
        apply();
        if (mq.addEventListener) mq.addEventListener("change", apply);
      })();
    </script>
  </head>
  <body class="fdn-page min-h-screen antialiased">
    <header class="border-b border-hairline">
      <div class="mx-auto flex h-[72px] max-w-3xl items-center px-4">
        <a href="/" class="fdn-wordmark">{SITE_NAME}</a>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-10">
      <slot />
    </main>

    {/* Global feedback island (§9): wires highlight-to-comment + fallback
        buttons wherever editorial entries render. Inert on pages without them. */}
    <FeedbackWidget client:idle />

    <footer class="mt-16 border-t border-hairline">
      <div class="mx-auto max-w-3xl space-y-3 px-4 py-8 text-sm text-ink-muted">
        <p>{INDEPENDENCE_DISCLAIMER}</p>
        <p>
          {WHO_ATTRIBUTION}
          <a href={WHO_SOURCE_URL} class="fdn-link">{WHO_SOURCE_URL}</a>
        </p>
        <p id="release-note" hidden>
          Basert på ICD-11 MMS, versjon <span id="release-version"></span>.
        </p>
        <p><a href="/personvern" class="fdn-link">Personvern</a></p>
      </div>
      <script>
        import { fetchHealth } from "../lib/who";

        const note = document.getElementById("release-note");
        const version = document.getElementById("release-version");
        if (note && version) {
          fetchHealth()
            .then((h) => {
              version.textContent = h.release;
              note.hidden = false;
            })
            .catch(() => {}); // release line simply stays hidden
        }
      </script>
    </footer>
  </body>
</html>
